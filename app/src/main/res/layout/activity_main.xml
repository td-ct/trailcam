<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp">

        <de.tdct.trailcam.CameraSurfaceView
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <de.tdct.trailcam.PickOverlayView
            android:id="@+id/pick_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#66000000"
            android:contentDescription="Men\u00fc"
            android:src="@android:drawable/ic_menu_more"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/zoom_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#AA000000"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:text="1.0x"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pick_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="56dp"
            android:background="#AA000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Farbe im Bild antippen"
            android:textColor="#FF4CE05A"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="@color/panel_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_mode"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:text="@string/btn_mode_mark"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_pick_color"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:text="@string/select_color"
                android:textAllCaps="false"
                android:enabled="false" />

            <View
                android:id="@+id/color_preview"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/darker_gray" />

            <Button
                android:id="@+id/btn_pick_eyedropper"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:text="Pipette"
                android:textAllCaps="false"
                android:enabled="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_tab_hue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:text="H (Farbe)" />

            <Button
                android:id="@+id/btn_tab_sat"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:text="S (S\u00e4ttigung)" />

            <Button
                android:id="@+id/btn_tab_val"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:text="V (Helligkeit)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <SeekBar
                android:id="@+id/hue_slider"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="180"
                android:progress="30"
                android:enabled="false" />

            <de.tdct.trailcam.RangeSeekBar
                android:id="@+id/sat_range"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:visibility="gone" />

            <de.tdct.trailcam.RangeSeekBar
                android:id="@+id/val_range"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/slide_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30\u00b0"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:minWidth="64dp"
                android:gravity="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>